  "settings": {
    "quickToggles": [
      {
        "key": "hideThinkingBlock",
        "labelKey": "setting_hide_thinking",
        "descriptionKey": "setting_hide_thinking_desc",
        "default": false
      },
      {
        "key": "enableSkillCommands",
        "labelKey": "setting_skill_commands",
        "descriptionKey": "setting_skill_commands_desc",
        "default": true
      },
      {
        "key": "quietStartup",
        "labelKey": "setting_quiet_startup",
        "descriptionKey": "setting_quiet_startup_desc",
        "default": false
      },
      {
        "key": "collapseChangelog",
        "labelKey": "setting_collapse_changelog",
        "descriptionKey": "setting_collapse_changelog_desc",
        "default": false
      },
      {
        "key": "enableInstallTelemetry",
        "labelKey": "setting_install_telemetry",
        "descriptionKey": "setting_install_telemetry_desc",
        "default": true
      },
      {
        "key": "enableAnalytics",
        "labelKey": "setting_analytics",
        "descriptionKey": "setting_analytics_desc",
        "default": false
      }
    ],
    "groups": [
      {
        "key": "defaults",
        "fields": [
          {
            "key": "defaultProvider",
            "type": "text"
          },
          {
            "key": "defaultModel",
            "type": "text"
          },
          {
            "key": "defaultThinkingLevel",
            "type": "select",
            "options": [
              "",
              "off",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh"
            ]
          },
          {
            "key": "steeringMode",
            "type": "select",
            "default": "one-at-a-time",
            "options": [
              "one-at-a-time",
              "all"
            ]
          },
          {
            "key": "followUpMode",
            "type": "select",
            "default": "one-at-a-time",
            "options": [
              "one-at-a-time",
              "all"
            ]
          }
        ]
      },
      {
        "key": "context",
        "fields": [
          {
            "key": "compaction.enabled",
            "type": "boolean",
            "default": true
          },
          {
            "key": "compaction.reserveTokens",
            "type": "number",
            "default": 16384,
            "min": 0
          },
          {
            "key": "compaction.keepRecentTokens",
            "type": "number",
            "default": 20000,
            "min": 0
          },
          {
            "key": "branchSummary.skipPrompt",
            "type": "boolean",
            "default": false
          }
        ]
      },
      {
        "key": "network",
        "fields": [
          {
            "key": "transport",
            "type": "select",
            "default": "auto",
            "options": [
              "auto",
              "sse",
              "websocket"
            ]
          },
          {
            "key": "retry.enabled",
            "type": "boolean",
            "default": true
          },
          {
            "key": "retry.maxRetries",
            "type": "number",
            "default": 3,
            "min": 0
          },
          {
            "key": "retry.baseDelayMs",
            "type": "number",
            "default": 2000,
            "min": 0
          },
          {
            "key": "httpProxy",
            "type": "text"
          },
          {
            "key": "httpIdleTimeoutMs",
            "type": "number",
            "min": 0
          },
          {
            "key": "websocketConnectTimeoutMs",
            "type": "number",
            "min": 0
          }
        ]
      },
      {
        "key": "tools",
        "fields": [
          {
            "key": "externalEditor",
            "type": "text"
          },
          {
            "key": "shellPath",
            "type": "text"
          },
          {
            "key": "images.autoResize",
            "type": "boolean",
            "default": true
          },
          {
            "key": "images.blockImages",
            "type": "boolean",
            "default": false
          }
        ]
      }
    ]
  },
  "language": {
    "storageKey": "piWebLang",
    "supported": [
      "en",
      "zh"
    ]
  },
  "theme": {
    "storageKey": "piWebTheme",
    "default": "system",
    "modes": [
      "system",
      "light",
      "dark"
    ]
  },
